# Configuration for livenx-si-findings-export.service.
# Commented values are the defaults. After editing run:
#   sudo systemctl restart livenx-si-findings-export
# This file holds an API token: keep it readable by root only (mode 0600).

# --- LiveNX REST API (default source) ---
# LiveNX server to read findings from (hostname or IP, optionally host:port).
SI_LIVENX_HOST=
# LiveNX API token: the same kind of token the other integrations in this
# repository use as LIVENX_API_TOKEN.
SI_API_TOKEN=
# Verify the LiveNX HTTPS certificate. Point SI_API_CA_FILE at the CA that
# signed it, or set SI_API_VERIFY_TLS=false for a self-signed certificate.
#SI_API_VERIFY_TLS=true
#SI_API_CA_FILE=
# Optional extra RSQL filter, for example: severity==High
#SI_API_FILTER=
# Full endpoint URL; overrides SI_LIVENX_HOST. Default:
#   https://<SI_LIVENX_HOST>/api/security-proxy/api/v1/findings
#SI_API_URL=

# --- Output ---
# JSON Lines, one finding per line, plus the exporter's position file.
# If you move these outside /data/si-findings-export, create the directory and
# make it writable by the si-findings-export user.
#SI_OUTPUT_FILE=/data/si-findings-export/si_findings.jsonl
#SI_STATE_FILE=/data/si-findings-export/state.json
# Rotate the output at this size and keep this many rotated files (.1 .. .N).
# Set SI_ROTATE_MAX_BYTES=0 to never rotate.
#SI_ROTATE_MAX_BYTES=104857600
#SI_ROTATE_KEEP=5

# --- Polling ---
# Seconds between polls.
#SI_POLL_INTERVAL=30
# Each poll re-reads this many seconds to catch findings that were written late.
# Must be longer than the worst insert delay on your system.
#SI_LOOKBACK_SECONDS=3600
# On first start only: how many hours of existing findings to export (0 = none).
#SI_INITIAL_BACKFILL_HOURS=24

# --- Alternative source: ClickHouse (only when installed on the LiveNX server) ---
# Set SI_SOURCE=clickhouse to read the table directly. Rows carry numeric codes
# instead of names. No token needed; the password of the read-only account is
# read from the users file LiveNX maintains.
#SI_SOURCE=api
#SI_CH_URL=https://127.0.0.1:10443
#SI_CH_DATABASE=livenx_platformdb
#SI_CH_TABLE=si_findings_dist
#SI_CH_USER=readonly
#SI_CH_PASSWORD=
#SI_CH_USERS_XML=/etc/clickhouse-server/users.d/users.xml
# CA bundle to verify the ClickHouse certificate. Empty = do not verify
# (LiveNX uses a self-signed certificate on localhost).
#SI_CH_CA_FILE=

#SI_LOG_LEVEL=INFO
