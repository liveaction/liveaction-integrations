# BlueCat Address Manager (source of alerts)
BAM_BASE=https://10.244.29.80
BAM_USER=apiuser
BAM_PASS=apipassword
BAM_VERIFY_TLS=false

# LiveNX OTEL collector (OTLP/gRPC + TLS + bearer token)
OTEL_ENDPOINT=127.0.0.1:4317
# OTEL_AUTH_TOKEN=   # optional; auto-read from /etc/la-otelcol.yaml when unset
OTEL_VERIFY_TLS=false

# Behavior
POLL_INTERVAL=60
MIN_SEVERITY=WARN      # INFO | WARN | ERROR
INITIAL_BACKFILL=0     # events to send on first run (0 = only new events)
